{
  "name": "@x402/agent-confidential-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "tsx deploy.ts",
    "deploy:sepolia": "tsx deploy-sepolia.ts",
    "facilitator": "tsx facilitator.ts",
    "facilitator:sepolia": "dotenv -e .env.sepolia -- tsx facilitator.ts",
    "server": "tsx server.ts",
    "server:sepolia": "dotenv -e .env.sepolia -- tsx server.ts",
    "agent": "tsx agent.ts",
    "agent:sepolia": "dotenv -e .env.sepolia -- tsx agent.ts",
    "dashboard": "tsx dashboard.ts",
    "dashboard:sepolia": "dotenv -e .env.sepolia -- tsx dashboard.ts",
    "mock-mpc": "dotenv -e .env.sepolia -- tsx mock-mpc.ts",
    "frontend:install": "cd frontend && pnpm install",
    "frontend:dev": "cd frontend && pnpm dev",
    "frontend:build": "cd frontend && pnpm build"
  },
  "dependencies": {
    "@x402/axios": "workspace:*",
    "@x402/core": "workspace:*",
    "@x402/evm": "workspace:*",
    "@x402/express": "workspace:*",
    "axios": "^1.13.2",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "viem": "^2.39.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "dotenv-cli": "^7.4.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
